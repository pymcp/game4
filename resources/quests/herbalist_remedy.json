      {"id": "mara_show_evidence", "description": "Mara analyses contaminated ore, sends player for herbs",   "status": "IMPLEMENTED"},
      {"id": "mara_completion",    "description": "Mara completion/reward dialogue",                          "status": "IMPLEMENTED"},
      {"id": "mara_pushed_deal",   "description": "CHA>=5 negotiation sets quest_herbalist_pushed_deal flag", "status": "IMPLEMENTED"}
    ],
    "notes": "Single linear branch. Player must enter mine, seal leak, collect evidence, show Mara, gather herbs/water, return to Mara."
  }
