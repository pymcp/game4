      {"id": "Mara", "role": "quest giver and turn-in", "location_hint": "near spawn", "status": "IMPLEMENTED"}
    ],
    "items": [
      {"id": "fennel_root",        "source": "gatherable plant",                 "status": "IMPLEMENTED"},
      {"id": "blue_nightcap",      "source": "gatherable mushroom",              "status": "IMPLEMENTED"},
      {"id": "clean_spring_water", "source": "interact with spring near spawn",  "status": "IMPLEMENTED"},
      {"id": "contaminated_ore",   "source": "mine leak interactable after boss","status": "IMPLEMENTED"},
      {"id": "tonic",              "source": "reward crafted by Mara",           "status": "IMPLEMENTED"},
      {"id": "antidote_recipe",    "source": "reward from Mara (CHA >= 5 path)", "status": "IMPLEMENTED"}
    ],
    "locations": [
      {"id": "moonstone_mine", "type": "dungeon",           "description": "labyrinth entrance east of spawn",  "status": "IMPLEMENTED"},
      {"id": "birch_grove",    "type": "terrain_landmark",  "description": "landmark between village and mine", "status": "IMPLEMENTED"},
      {"id": "village_well",   "type": "interaction_point", "description": "contaminated well in starting area","status": "IMPLEMENTED"},
      {"id": "spring",         "type": "interaction_point", "description": "clean water source near spawn",     "status": "IMPLEMENTED"}
    ],
    "entities": [
      {"id": "corrupted_golem", "type": "boss_mob",    "description": "boss in moonstone mine",           "status": "IMPLEMENTED"},
      {"id": "sick_wolf",       "type": "hostile_mob", "description": "wolves near mine that don't flee", "status": "IMPLEMENTED"},
      {"id": "rat",             "type": "hostile_mob", "description": "feral animals near mine",          "status": "IMPLEMENTED"}
    ],
    "terrain_features": [
      {"id": "mine_leak", "type": "interactable", "description": "spawns after boss kill in mine", "status": "IMPLEMENTED"}
