[sub_resource type="Resource" id="Resource_23wse"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "You're back! Have you found the herbs I need? Fennel root, blue nightcap mushrooms, and clean spring water. The valley grows sicker by the day."
