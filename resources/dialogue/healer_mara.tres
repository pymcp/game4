[sub_resource type="Resource" id="Resource_o66w8"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "The sickness started near the old mine in the eastern hills. Something seeped into the groundwater. If you go there, be careful — the animals nearby have gone feral."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_txsrw"]
script = ExtResource("2_qpsg2")
label = "Where exactly is this mine?"
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_o66w8")
require_flag = ""
set_flag = ""

[sub_resource type="Resource" id="Resource_jr80g"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "Hmm, I'm not sure what you mean. But the mine is east of here, past the birch grove. Start there."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_fitwt"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "I've been studying the well water. There's a strange residue — almost like crushed moonstone. The mine used to produce that before it was abandoned. That's your lead."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_r0gug"]
script = ExtResource("2_qpsg2")
label = "Could the ore itself be toxic?"
stat_check = &"wisdom"
stat_threshold = 4
next_node = SubResource("Resource_fitwt")
failure_node = SubResource("Resource_jr80g")
require_flag = ""
set_flag = ""

[sub_resource type="Resource" id="Resource_l8vmk"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "I understand your scepticism. But three villages have lost livestock this moon alone. If you change your mind, you know where to find me."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_odxch"]
script = ExtResource("2_qpsg2")
label = "I'm not sure I believe that."
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_l8vmk")
require_flag = ""
set_flag = ""

[sub_resource type="Resource" id="Resource_m5b4f"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "I've traced it to the water. Every sick animal drinks from streams fed by the eastern hills. The old moonstone mine was sealed twenty years ago, but something's broken through."
choices = Array[Resource]([SubResource("Resource_txsrw"), SubResource("Resource_r0gug"), SubResource("Resource_odxch")])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_vuh47"]
script = ExtResource("2_qpsg2")
label = "What do you know about the cause?"
stat_check = &"wisdom"
stat_threshold = 3
next_node = SubResource("Resource_m5b4f")
require_flag = ""
set_flag = ""

[sub_resource type="Resource" id="Resource_3qdwx"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "Fair enough. Bring me proof from the mine — a water sample or a piece of the contaminated ore — and I'll craft you a tonic that'll make you tougher than boiled leather."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_fe8sf"]
script = ExtResource("2_qpsg2")
label = "Sounds fair. What do you need?"
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_3qdwx")
require_flag = ""
set_flag = "quest_herbalist_mine"

[sub_resource type="Resource" id="Resource_fa123"]
