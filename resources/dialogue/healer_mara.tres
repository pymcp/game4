[sub_resource type="Resource" id="Resource_eck7w"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "You've taken on quite a task! The herbs — fennel root, blue nightcap, and spring water — and sealing the mine. The valley is counting on you."
