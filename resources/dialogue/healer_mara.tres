[sub_resource type="Resource" id="Resource_jidbr"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "The valley owes you a debt it can never repay. The animals are recovering and the water runs clear again. If you ever need a tonic, you know where to find me."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_lbgco"]
script = ExtResource("2_gna55")
label = "How is the valley doing?"
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_jidbr")
require_flag = "quest_herbalist_remedy_complete"
require_flag_false = ""
set_flag = ""

[sub_resource type="Resource" id="Resource_u0mlx"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "Yes! This ore is saturated with corrupted moonstone residue -- just as I feared. I need fennel root, a blue nightcap mushroom, and clean spring water -- not from the village well. The spring east of the birch grove is safe."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_mdrai"]
script = ExtResource("2_gna55")
label = "Here are the herbs and water you asked for."
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_u0mlx")
require_flag = "quest_herbalist_remedy_obj_show_evidence_done"
require_flag_false = "quest_herbalist_remedy_complete"
set_flag = ""

[sub_resource type="Resource" id="Resource_y7vvc"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "The mine entrance is east of here, past the birch grove. Watch for sick wolves -- they don't run from people anymore. Seal whatever is leaking and bring back a piece of contaminated ore as proof."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_4i75p"]
script = ExtResource("2_gna55")
label = "I'm on my way to the mine."
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_y7vvc")
require_flag = "quest_herbalist_main"
require_flag_false = "quest_herbalist_remedy_obj_show_evidence_done"
set_flag = ""

[sub_resource type="Resource" id="Resource_dqmd0"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "The sickness started near the old mine in the eastern hills. Something seeped into the groundwater. If you go there, be careful -- the animals nearby have gone feral."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_t2l0w"]
script = ExtResource("2_gna55")
label = "Where exactly is this mine?"
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_dqmd0")
require_flag = ""
require_flag_false = ""
set_flag = ""

[sub_resource type="Resource" id="Resource_wr4f1"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "Hmm, I'm not sure what you mean. But the mine is east of here, past the birch grove. Start there."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_hwmdk"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "I've been studying the well water. There's a strange residue -- almost like crushed moonstone. The mine used to produce that before it was abandoned. That's your lead."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_t0x2c"]
script = ExtResource("2_gna55")
label = "Could the ore itself be toxic?"
stat_check = &"wisdom"
stat_threshold = 4
next_node = SubResource("Resource_hwmdk")
failure_node = SubResource("Resource_wr4f1")
require_flag = ""
require_flag_false = ""
set_flag = ""

[sub_resource type="Resource" id="Resource_etnfo"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "I understand your scepticism. But three villages have lost livestock this moon alone. If you change your mind, you know where to find me."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_8tvhw"]
script = ExtResource("2_gna55")
label = "I'm not sure I believe that."
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_etnfo")
require_flag = ""
require_flag_false = ""
set_flag = ""

[sub_resource type="Resource" id="Resource_krc0l"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "I've traced it to the water. Every sick animal drinks from streams fed by the eastern hills. The old moonstone mine was sealed twenty years ago, but something's broken through."
choices = Array[Resource]([SubResource("Resource_t2l0w"), SubResource("Resource_t0x2c"), SubResource("Resource_8tvhw")])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_5ndx3"]
script = ExtResource("2_gna55")
label = "What do you know about the cause of this sickness?"
stat_check = &"wisdom"
stat_threshold = 3
next_node = SubResource("Resource_krc0l")
require_flag = ""
require_flag_false = "quest_herbalist_main"
set_flag = ""

[sub_resource type="Resource" id="Resource_4j5t0"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "Fair enough. Bring me proof from the mine -- a piece of contaminated ore -- and I'll craft you a tonic that'll make you tougher than boiled leather."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_y2j6c"]
script = ExtResource("2_gna55")
label = "Sounds fair. What exactly do you need?"
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_4j5t0")
require_flag = ""
require_flag_false = ""
set_flag = "quest_herbalist_main"

[sub_resource type="Resource" id="Resource_erh1s"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "That's too much to ask. The tonic or nothing, traveller."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_uma4d"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "You drive a hard bargain, traveller. Fine -- bring evidence from the mine and I'll give you my last bottled antidote AND the tonic recipe. But don't dawdle."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_uk8uv"]
script = ExtResource("2_gna55")
label = "I want the tonic AND your antidote recipe."
stat_check = &"charisma"
stat_threshold = 5
next_node = SubResource("Resource_uma4d")
failure_node = SubResource("Resource_erh1s")
require_flag = ""
require_flag_false = ""
