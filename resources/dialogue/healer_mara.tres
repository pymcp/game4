[sub_resource type="Resource" id="Resource_7msag"]
script = ExtResource("1_lsla6")
speaker = "Mara"
text = "The mine entrance is east of the birch grove. The sick wolves are still prowling nearby -- don't let them surround you. Find what's leaking inside, seal it, and bring back a piece of the ore. Come back to me when you have it."
