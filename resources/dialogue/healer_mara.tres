[sub_resource type="Resource" id="Resource_4frd8"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "Then go -- east past the birch grove. The mine entrance is hard to miss. Come back with ore from inside and I'll know what we're dealing with."
