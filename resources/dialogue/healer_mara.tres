[sub_resource type="Resource" id="Resource_4e8ly"]
script = ExtResource("1_lsla6")
speaker = "Mara"
text = "The valley's breathing easier. Whatever was in that ore, you stopped it from spreading further. Come back when you need a tonic -- I'll always have one ready for you."
