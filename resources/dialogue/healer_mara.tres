[sub_resource type="Resource" id="Resource_ttbkj"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "The valley owes you a debt it can never repay. The animals are recovering and the water runs clear again. If you ever need a tonic, you know where to find me."
