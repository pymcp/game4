[sub_resource type="Resource" id="Resource_iwvn3"]
script = ExtResource("1_vpfwl")
speaker = "Mara"
text = "The mine entrance is east of here. Seal whatever is leaking down there and bring back proof — a piece of that contaminated ore. Be careful."
choices = Array[Resource]([])
condition_flag = "quest_herbalist_mine"
condition_flag_false = "quest_herbalist_remedy_complete"

[sub_resource type="Resource" id="Resource_887lu"]
