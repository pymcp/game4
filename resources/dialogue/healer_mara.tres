[sub_resource type="Resource" id="Resource_ebfk8"]
script = ExtResource("1_oudbo")
speaker = "Mara"
text = "I don't have much gold, but I can offer something better. I brew tonics that'll harden your skin and sharpen your senses. One batch is worth more than a sack of coin."
choices = Array[Resource]([SubResource("Resource_y2j6c"), SubResource("Resource_uk8uv"), SubResource("Resource_bc8rd")])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_be2kj"]
