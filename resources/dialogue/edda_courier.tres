[sub_resource type="Resource" id="Resource_kpo1y"]
script = ExtResource("1_vtbkn")
speaker = "Edda"
text = "The well, the farm, the mine — it's the same story I've heard in a dozen valleys. Something is wrong with the land here, and it's not local. If you're ever heading east, find the docks at Tidehaven. Ask for Aldric Farrow. He knows those waters better than anyone alive. Tell him Edda sent you."
choices = Array[Resource]([])
condition_flag = ""
condition_flag_false = ""

[sub_resource type="Resource" id="Resource_q3ron"]
script = ExtResource("2_364rs")
label = "I've checked the well and spoken to the farmer."
stat_check = &""
stat_threshold = 0
next_node = SubResource("Resource_kpo1y")
require_flag = "quest_valley_witness_obj_speak_farmer_done"
require_flag_false = "edda_quest_complete"
set_flag = ""

[sub_resource type="Resource" id="Resource_aowug"]
