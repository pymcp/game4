[sub_resource type="Resource" id="Resource_abxdy"]
script = ExtResource("1_vtbkn")
speaker = "Edda"
text = "You. You've come through the wilds recently — I can tell. I've been mapping this sickness across a dozen regions. It's always the same: animals go feral near old mines, the water turns, the farmers start losing livestock. I need this valley documented before I move on. You can help."
choices = Array[Resource]([SubResource("Resource_myt2n"), SubResource("Resource_0visj")])
condition_flag = ""
condition_flag_false = ""

