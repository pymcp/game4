[sub_resource type="Resource" id="Resource_muqnq"]
script = ExtResource("1_vtbkn")
speaker = "Edda"
text = "Two things: examine the village well and tell me what you smell on the water, then find whoever farms nearest to the mine and ask them what's changed with their animals. I'll wait here."
choices = Array[Resource]([SubResource("Resource_2t0be"), SubResource("Resource_fc1fx")])
condition_flag = ""
condition_flag_false = ""

