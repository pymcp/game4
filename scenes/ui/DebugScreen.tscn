[node name="Close" type="Button" parent="Center/Panel/Margin/VBox/MainButtons"]
theme_type_variation = &"WoodButton"
focus_mode = 0
text = "Close"

[node name="SubPanel" type="VBoxContainer" parent="Center/Panel/Margin/VBox"]
visible = false
theme_override_constants/separation = 8

[node name="SubTitle" type="Label" parent="Center/Panel/Margin/VBox/SubPanel"]
